#!/usr/bin/env python3
"""Generated by Siphon — Automatic API flow replay script"""
{%- if ctx.needs_regex %}

import re
import requests
{%- else %}

import requests
{%- endif %}
{%- if ctx.has_parameters %}

# ── Configurable Parameters ──
{%- for param in ctx.parameters %}
{%- if param.default_value %}
{{ param.var_name }} = "{{ param.default_value }}"
{%- else %}
{{ param.var_name }} = ""  # TODO: set value
{%- endif %}
{%- endfor %}
{%- endif %}

session = requests.Session()
{%- for req in ctx.requests %}

# ── Step {{ req.order + 1 }}: {{ req.method }} {{ req.url }} ──
{%- for inj in req.injections %}
# Uses: {{ inj.variable_name }} ({{ inj.target }}: {{ inj.key }})
{%- endfor %}
{%- if req.headers | length > 0 %}

headers_{{ req.order }} = {
{%- for h in req.headers %}
{%- if h.is_dynamic %}
    "{{ h.name }}": f"{{ h.python_value }}",
{%- else %}
    "{{ h.name }}": "{{ h.value }}",
{%- endif %}
{%- endfor %}
}
{%- endif %}
{%- if req.has_body and req.is_json_body %}

response_{{ req.order }} = session.{{ req.method | lower }}(
    {% if req.has_injections %}f"{{ req.python_url }}"{% else %}"{{ req.url }}"{% endif %},
{%- if req.headers | length > 0 %}
    headers=headers_{{ req.order }},
{%- endif %}
{%- if req.is_redirect %}
    allow_redirects=False,
{%- endif %}
    json={{ req.python_body }})
{%- elif req.has_body %}
{%- if req.has_injections %}

body_{{ req.order }} = f"""{{ req.python_body }}"""
{%- else %}

body_{{ req.order }} = """{{ req.python_body }}"""
{%- endif %}

response_{{ req.order }} = session.{{ req.method | lower }}(
    {% if req.has_injections %}f"{{ req.python_url }}"{% else %}"{{ req.url }}"{% endif %},
{%- if req.headers | length > 0 %}
    headers=headers_{{ req.order }},
{%- endif %}
{%- if req.is_redirect %}
    allow_redirects=False,
{%- endif %}
    data=body_{{ req.order }})
{%- else %}

response_{{ req.order }} = session.{{ req.method | lower }}(
    {% if req.has_injections %}f"{{ req.python_url }}"{% else %}"{{ req.url }}"{% endif %}
{%- if req.headers | length > 0 %},
    headers=headers_{{ req.order }}
{%- endif %}
{%- if req.is_redirect %},
    allow_redirects=False
{%- endif %})
{%- endif %}

print(f"Step {{ req.order + 1 }}: {response_{{ req.order }}.status_code} {{ req.method }} {{ req.url }}")
{%- if req.expected_status > 0 %}
assert response_{{ req.order }}.status_code == {{ req.expected_status }}, f"Expected {{ req.expected_status }}, got {response_{{ req.order }}.status_code}"
{%- endif %}
{%- for ext in req.extractions %}
{%- if ext.method == "json" %}

{{ ext.variable_name }} = response_{{ req.order }}.json(){{ ext.path }}
{%- elif ext.method == "header" %}

{{ ext.variable_name }} = response_{{ req.order }}.headers.get("{{ ext.path }}")
{%- elif ext.method == "cookie" %}

{{ ext.variable_name }} = session.cookies.get("{{ ext.path }}")
{%- elif ext.method == "html" or ext.method == "regex" %}

_match = re.search(r'{{ ext.regex_pattern }}', response_{{ req.order }}.text)
{{ ext.variable_name }} = _match.group(1) if _match else None
{%- endif %}
print(f"  Extracted {{ ext.variable_name }}: {str( {{- ext.variable_name -}} )[:20]}...")
{%- endfor %}
{%- endfor %}

print("\nFlow complete!")
