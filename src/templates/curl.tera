#!/usr/bin/env bash
# Generated by Siphon — Automatic API flow replay script
set -euo pipefail
{%- if ctx.has_parameters %}

# ── Configurable Parameters ──
{%- for param in ctx.parameters %}
{%- if param.default_value %}
{{ param.var_name }}="${ {{- param.var_name -}} :-{{ param.default_value }}}"
{%- else %}
{{ param.var_name }}="${ {{- param.var_name -}} :-}"  # TODO: set value
{%- endif %}
{%- endfor %}
{%- endif %}

COOKIE_JAR=$(mktemp)
trap 'rm -f "$COOKIE_JAR"' EXIT
{%- for req in ctx.requests %}

# ── Step {{ req.order + 1 }}: {{ req.method }} {{ req.url }} ──
{%- if req.extractions | length > 0 %}
RESPONSE_{{ req.order }}=$(curl -s -D HEADERS_{{ req.order }}.tmp -w "\n%{http_code}" \
{%- else %}
STATUS_{{ req.order }}=$(curl -s -o /dev/null -w "%{http_code}" \
{%- endif %}
  -X {{ req.method }} \
  -b "$COOKIE_JAR" -c "$COOKIE_JAR" \
{%- for h in req.headers %}
  -H "{{ h.name }}: {{ h.curl_value }}" \
{%- endfor %}
{%- if req.has_body %}
{%- if req.body_has_variables %}
  -d "{{ req.curl_body }}" \
{%- else %}
  -d '{{ req.curl_body }}' \
{%- endif %}
{%- endif %}
{%- if req.extractions | length > 0 %}
  "{% if req.has_injections %}{{ req.curl_url }}{% else %}{{ req.url }}{% endif %}")

BODY_{{ req.order }}=$(echo "$RESPONSE_{{ req.order }}" | sed '$d')
STATUS_{{ req.order }}=$(echo "$RESPONSE_{{ req.order }}" | tail -1)
echo "Step {{ req.order + 1 }}: $STATUS_{{ req.order }} {{ req.method }} {{ req.url }}"
{%- if req.expected_status > 0 %}
[[ "$STATUS_{{ req.order }}" != "{{ req.expected_status }}" ]] && echo "Expected {{ req.expected_status }}, got $STATUS_{{ req.order }}" && exit 1
{%- endif %}
{% for ext in req.extractions %}
{%- if ext.method == "json" %}
{{ ext.variable_name | upper }}=$(echo "$BODY_{{ req.order }}" | python3 -c 'import sys,json; print(json.load(sys.stdin){{ ext.path }})')
{%- elif ext.method == "header" %}
{{ ext.variable_name | upper }}=$(grep -i "^{{ ext.path }}:" HEADERS_{{ req.order }}.tmp | sed 's/^[^:]*: //' | tr -d '\r\n')
{%- elif ext.method == "cookie" %}
{{ ext.variable_name | upper }}=$(grep "{{ ext.path }}" "$COOKIE_JAR" | awk '{print $NF}')
{%- elif ext.method == "html" or ext.method == "regex" %}
{{ ext.variable_name | upper }}=$(echo "$BODY_{{ req.order }}" | python3 -c "import sys,re; m=re.search(r'{{ ext.regex_pattern }}', sys.stdin.read()); print(m.group(1) if m else '')")
{%- endif %}
echo "  Extracted {{ ext.variable_name }}: ${ {{- ext.variable_name | upper -}} :0:20}..."
{%- endfor %}
rm -f HEADERS_{{ req.order }}.tmp
{%- else %}
  "{% if req.has_injections %}{{ req.curl_url }}{% else %}{{ req.url }}{% endif %}")

echo "Step {{ req.order + 1 }}: $STATUS_{{ req.order }} {{ req.method }} {{ req.url }}"
{%- if req.expected_status > 0 %}
[[ "$STATUS_{{ req.order }}" != "{{ req.expected_status }}" ]] && echo "Expected {{ req.expected_status }}, got $STATUS_{{ req.order }}" && exit 1
{%- endif %}
{%- endif %}
{%- endfor %}

echo ""
echo "Flow complete!"
